{
  "name": "callnet-platform",
  "version": "1.0.0",
  "description": "Plateforme de gestion de commandes e-commerce pour Call Center.",
  "main": "api/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "postinstall": "node -e 'try{const fs=require(\"fs\"),p=\"./node_modules/whatsapp-rust-bridge/package.json\";if(fs.existsSync(p)){const pkg=JSON.parse(fs.readFileSync(p,\"utf8\"));pkg.main=\"./dist/index.js\";pkg.exports[\".\"]={import:\"./dist/index.js\",require:\"./dist/index.js\",default:\"./dist/index.js\",types:\"./dist/index.d.ts\"};fs.writeFileSync(p,JSON.stringify(pkg,null,2));}}catch(e){}'",
    "start": "node dist/server.cjs",
    "db-setup": "tsx api/setup-db.ts"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@supabase/supabase-js": "^2.114.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "body-parser": "^1.20.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "uuid": "^10.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
